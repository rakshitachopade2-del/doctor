# Production only. npm run dev uses the separate local demo defaults.
NODE_ENV=production
DEMO_MODE=false
HOST=127.0.0.1
PORT=3001
# Use a fresh path; production refuses databases seeded with public demo accounts.
DATABASE_PATH=data/production.sqlite
# Exact HTTPS origin used by patients and staff. No trailing slash.
APP_ORIGIN=https://clinic.example.com
# Optional canonical origin for published library pages; defaults to APP_ORIGIN.
PUBLIC_SITE_ORIGIN=
# Enable public-library indexing only for an intentional production publication.
# Demo/development pages and private routes always remain noindex.
PUBLIC_INDEXING_ENABLED=false
# Enable only when deployed behind a single trusted reverse proxy.
TRUST_PROXY=false
# Checks enabled follow-up escalation policies at startup and every 15 minutes.
# Set false for manual-only notices; the clinic policy itself starts disabled.
FOLLOW_UP_ESCALATION_AUTO=true
# Optional authenticator MFA: generate and securely retain a unique 32-byte key (64 hex characters).
# Keep it separate from database backups. Existing enrolled accounts require the same key on restart.
MFA_ENCRYPTION_KEY=

# Production only. npm run dev uses the separate local demo defaults.
NODE_ENV=production
DEMO_MODE=false
HOST=127.0.0.1
PORT=3001
# Use a fresh path; production refuses databases seeded with public demo accounts.
DATABASE_PATH=data/production.sqlite
# Exact HTTPS origin used by patients and staff. No trailing slash.
APP_ORIGIN=https://clinic.example.com
# Enable only when deployed behind a single trusted reverse proxy.
TRUST_PROXY=false

{
  "name": "derma-clinic-platform",
  "version": "1.24.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/production.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:production": "node scripts/production-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "create-admin": "node --env-file-if-exists=.env --import tsx server/create-admin.ts",
    "backup": "node --env-file-if-exists=.env --import tsx server/backup.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mfa:reset": "node --env-file-if-exists=.env --import tsx server/reset-mfa.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tsx": "^4.19.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.51.1",
    "@types/express": "^5.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
